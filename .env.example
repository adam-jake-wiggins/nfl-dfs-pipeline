# Copy this file to .env and fill in real values:
#
#     cp .env.example .env
#
# .env is listed in .gitignore and must never be committed. This file is
# committed so that anyone cloning the repository knows which variables the
# pipeline needs, without ever seeing anyone's actual credentials.

# The Odds API -- https://the-odds-api.com
# Free tier: 500 requests/month, current odds only (no historical endpoint).
# Used by the snapshot harness to capture spreads and totals for each slate.
ODDS_API_KEY=replace_me
